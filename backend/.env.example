# Scoot Master — Backend API
PORT=4000
# Chemin du fichier SQLite (dossier ./data créé automatiquement)
DB_PATH=./data/scoot.db
# Secret JWT — CHANGEZ EN PRODUCTION
# ATTENTION : changer ce secret invalide toutes les sessions en cours
# (tous les utilisateurs sont déconnectés). Gardez-le STABLE en production.
JWT_SECRET=changez-moi-en-production
# Durée de vie d'une session (s, m, h, d). La session reste ouverte tant que
# l'utilisateur ne se déconnecte pas : l'app renouvelle le jeton en arrière-plan.
JWT_TTL=30d
# Tolérance de renouvellement : un jeton expiré depuis moins que cette durée
# peut encore être renouvelé (appareil resté hors ligne / en veille).
JWT_REFRESH_GRACE=60d
# Origines CORS autorisées ('*' par défaut). L'API s'authentifie par en-tête
# Authorization (aucun cookie) : '*' n'expose pas à un CSRF et évite qu'une
# liste blanche incomplète bloque la synchronisation du web.
CORS_ORIGIN=*
# 'true' pour refuser réellement les origines hors liste (négocie le blocage
# navigateur au lieu de servir la requête). À réserver aux listes vérifiées.
CORS_STRICT=false
# Semer les données de démo au démarrage (true/false)
SEED_ON_START=true

# ---------------------------------------------------------------------------
# Sauvegarde automatisée vers Google Drive (compte de service)
# ---------------------------------------------------------------------------
# 1. Console Google Cloud → IAM & Admin → Comptes de service → Créer un compte.
# 2. Clés → Ajouter une clé → JSON : récupérez `client_email` et `private_key`.
# 3. Google Drive : créez/choisissez un dossier et PARTAGEZ-le (éditeur) avec
#    l'e-mail du compte de service, sinon l'API répond 403/404.
# 4. Renseignez les variables ci-dessous puis passez BACKUP_ENABLED=true.

# Active la tâche planifiée interne (false = aucune sauvegarde automatique).
BACKUP_ENABLED=false
# E-mail du compte de service (champ `client_email` du fichier JSON).
GOOGLE_CLIENT_EMAIL=
# Clé privée du compte de service. Sur une seule ligne, avec des `\n` littéraux :
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# Id du dossier Drive cible (la partie après /folders/ dans son URL). Vide = racine.
GOOGLE_DRIVE_FOLDER_ID=
# Nom de dossier utilisé comme libellé/documentation (facultatif).
GOOGLE_DRIVE_FOLDER_NAME=Scoot Master Backups
# Intervalle entre deux sauvegardes, en heures (24 = quotidienne).
BACKUP_INTERVAL_HOURS=24
# Format du fichier envoyé : json (dump complet) ou csv.
BACKUP_FORMAT=json
# Points d'entrée Google (à ne surcharger que pour les tests/proxies).
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# GOOGLE_DRIVE_API_BASE=https://www.googleapis.com/drive/v3
# GOOGLE_UPLOAD_API_BASE=https://www.googleapis.com/upload/drive/v3
