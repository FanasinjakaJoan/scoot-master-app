# Scoot Master — Backend API
PORT=4000
# Chemin du fichier SQLite (dossier ./data créé automatiquement)
DB_PATH=./data/scoot.db
# Secret JWT — CHANGEZ EN PRODUCTION
# ATTENTION : changer ce secret invalide toutes les sessions en cours
# (tous les utilisateurs sont déconnectés). Gardez-le STABLE en production.
JWT_SECRET=changez-moi-en-production
# Durée de vie d'une session (s, m, h, d). La session reste ouverte tant que
# l'utilisateur ne se déconnecte pas : l'app renouvelle le jeton en arrière-plan.
JWT_TTL=30d
# Tolérance de renouvellement : un jeton expiré depuis moins que cette durée
# peut encore être renouvelé (appareil resté hors ligne / en veille).
JWT_REFRESH_GRACE=60d
# Origines CORS autorisées ('*' par défaut). L'API s'authentifie par en-tête
# Authorization (aucun cookie) : '*' n'expose pas à un CSRF et évite qu'une
# liste blanche incomplète bloque la synchronisation du web.
CORS_ORIGIN=*
# 'true' pour refuser réellement les origines hors liste (négocie le blocage
# navigateur au lieu de servir la requête). À réserver aux listes vérifiées.
CORS_STRICT=false
# Semer les données de démo au démarrage (true/false)
SEED_ON_START=true

# ---------------------------------------------------------------------------
# Sauvegarde Firebase (Cloud Storage) — voir README.md § « Sauvegarde Firebase »
# ---------------------------------------------------------------------------
# NE JAMAIS COMMITTER backend/.env : il est ignoré par git (voir .gitignore).
# Le compte de service (Console Firebase → Paramètres → Comptes de service)
# doit être limité à « Storage Object Admin » sur le seul bucket de sauvegarde
# (et « Cloud Datastore Import Export Admin » si l'export Firestore est activé).

# Interrupteur principal. Sans credentials, la sauvegarde reste « skipped ».
FIREBASE_BACKUP_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clé privée sur UNE ligne, \n compris (guillemets recommandés en .env).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Bucket de destination, ex. scoot-master-backups
FIREBASE_STORAGE_BUCKET=
# Dossier (préfixe) des sauvegardes dans le bucket.
FIREBASE_BACKUP_PREFIX=backups/
# Cadence de la sauvegarde planifiée (heures) et nombre de fichiers conservés.
FIREBASE_BACKUP_INTERVAL_HOURS=24
FIREBASE_BACKUP_RETENTION=30
# 'true' pour exporter la base Firestore en natif (projects.databases.exportDocuments)
# au lieu de sérialiser la base SQLite de l'application.
FIREBASE_FIRESTORE_EXPORT_ENABLED=false
